POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alternative_data
POSTGRES_USER=alternative_data
POSTGRES_PASSWORD=change_me
# DATABASE_URL overrides POSTGRES_* when set.
# DATABASE_URL=postgresql+psycopg://alternative_data:change_me@localhost:5432/alternative_data
LOG_LEVEL=INFO
RAW_PAYLOAD_MAX_BYTES=1048576
TRAVEL_MIDWEST_USERNAME=
TRAVEL_MIDWEST_PASSWORD=
# Authenticated LinkTrafficReport.xml.gz endpoint. Leave unset until the
# account is approved and a manual fixture-validated smoke test is planned.
TRAVEL_MIDWEST_TRAFFIC_FEED_URL=
# Public, slowly changing camera directory (not a traffic time series).
TRAVEL_MIDWEST_CAMERA_FEED_URL=
TRAVEL_MIDWEST_INCIDENT_FEED_URL=
TRAVEL_MIDWEST_CONSTRUCTION_FEED_URL=
TRAVEL_MIDWEST_SENSOR_FEED_URL=
CAMERA_STORAGE_PATH=data/cameras
TRAVEL_MIDWEST_MIN_INTERVAL_SECONDS=300
MARKET_SYMBOLS=SPY,QQQ,DIA,IWM,IYT,XLI,AMZN,UPS,FDX,WMT,TGT,COST,XPO,CHRW,DAL,UAL,LUV,AAL,UNP,CSX,JBHT
MARKET_START_DATE=2010-01-01
