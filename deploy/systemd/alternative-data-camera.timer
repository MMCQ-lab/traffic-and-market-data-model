[Unit]
Description=Run Travel Midwest camera metadata ingestion monthly

[Timer]
# The provider says this directory changes infrequently. Refresh it on the
# first day of each month, using an explicit timezone for predictable ops.
OnCalendar=*-*-01 03:00:00 America/Chicago
Persistent=true
Unit=alternative-data-camera.service

[Install]
WantedBy=timers.target
