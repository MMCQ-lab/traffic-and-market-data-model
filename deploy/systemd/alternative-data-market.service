[Unit]
Description=Ingest daily Yahoo Finance market data
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/traffic-and-market-data-model
ExecStart=/usr/bin/docker compose --env-file .env -f docker-compose.server.yml run --rm ingestor python -m scripts.ingest_yahoo_finance
